{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anywhere Computer Manager Preview",
  "version": "0.1.0-alpha.10",
  "identifier": "org.anywherecomputer.manager.preview",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "Anywhere Computer", "width": 980, "height": 760, "minWidth": 520, "minHeight": 500}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false }
}
